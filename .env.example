# Host publication: default loopback (private). OPTIONAL explicit public mode:
# MINIPOOL_STRATUM_BIND_IP=0.0.0.0
# MINIPOOL_WEB_BIND_IP=0.0.0.0
# Both ports exposed publicly require external firewall/rate limiting.
# Public dashboard HTTP exposes miners' wallet addresses and event logs.
# Host header allowlisting is NOT authentication.
MINIPOOL_STRATUM_BIND_IP=127.0.0.1
MINIPOOL_WEB_BIND_IP=127.0.0.1

# Legacy optional compose.lan.yaml: trusted Linux host private LAN IPv4 only:
# STRATUM_BIND_IP=192.168.178.55
MINIPOOL_SHARE_DIFFICULTY=1024

# Only with Nginx Proxy Manager and HTTPS + Access List authentication:
# MINIPOOL_DASHBOARD_ALLOWED_HOSTS=pool.example.com,YOUR_PUBLIC_IPV4
MINIPOOL_DASHBOARD_ALLOWED_HOSTS=
NPM_DOCKER_NETWORK=npm_proxy
